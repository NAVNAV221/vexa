[Unit]
Description=Vexa after-meeting pass: ivrit.ai transcript + Claude summary to Slack
After=docker.service network-online.target

[Service]
User=navebennaim
WorkingDirectory=/home/navebennaim/.local/share/uvi-finalizer
EnvironmentFile=/home/navebennaim/.config/uvi/finalizer.env
ExecStart=/home/navebennaim/.local/share/uvi-finalizer/venv/bin/python -u /home/navebennaim/vexa/uvi/meeting-finalizer/finalize.py
Nice=10
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
